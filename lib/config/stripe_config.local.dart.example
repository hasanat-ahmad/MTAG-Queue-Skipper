/// Copy this file to `stripe_config.local.dart` (same folder).
/// `stripe_config.local.dart` is gitignored and never pushed to GitHub.
///
/// Get the publishable key from Stripe Dashboard → Developers → API keys.
/// Only the publishable key (pk_...) belongs in the app. The secret key
/// (sk_...) goes to the Cloud Functions instead:
///   firebase functions:secrets:set STRIPE_SECRET_KEY

class StripeLocalSecrets {
  StripeLocalSecrets._();

  static const String publishableKey = 'pk_test_YOUR_KEY_HERE';
}
